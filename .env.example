# Canonical Gemini credential. GEMINI_API_KEY remains a compatibility fallback.
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
DISCORD_WEBHOOK_URL=

# Model IDs are configuration, never hard-coded in Python.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LITE_MODEL=
OPENAI_MODEL=gpt-5-mini
COLQWEN_MODEL=vidore/colqwen2-v1.0-hf
MODEL_MAX_TOKENS=4096

# Reserved for the Phase 4 local interface.
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7861

# 0 disables the in-process guard for local use. Public containers override to 60.
PUBLIC_MAX_REQUESTS_PER_HOUR=0

# Optional local evidence OCR for scanned pages. Needs `uv sync --extra local-ocr`
# and a Tesseract 5 binary; leave false to keep such pages as page_only.
EVIDENCE_OCR=false
EVIDENCE_OCR_LANGUAGES=chi_tra+chi_sim+eng
